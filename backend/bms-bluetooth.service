[Unit]
Description=BMS Bluetooth Gateway Service
After=bms-backend.service
Requires=bms-backend.service

[Service]
Type=simple
User=raspi
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/home/raspi/bms_project/CLEANED DATA SETS
ExecStartPre=/usr/bin/sudo /usr/sbin/rfkill unblock bluetooth
ExecStartPre=/usr/bin/sudo /usr/bin/hciconfig hci0 up
ExecStart=/bin/bash -c 'source venv/bin/activate && python bms_bluetooth_gateway.py --bms JBD --mac A4:C1:37:04:28:FB --interval 1.0'
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
